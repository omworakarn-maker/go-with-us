            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"ทริปทดสอบ Integration\",\n  \"destination\": \"ชลบุรี (พัทยา)\",\n  \"description\": \"ทริปสำหรับทดสอบการเชื่อมต่อระบบ\",\n  \"startDate\": \"2026-09-20\",\n  \"endDate\": \"2026-09-20\",\n  \"budget\": 1000,\n  \"budgetType\": \"per_person\",\n  \"maxParticipants\": 4,\n  \"category\": \"ทะเล\",\n  \"interestTags\": [\"ถ่ายรูป\", \"อาหาร\"],\n  \"timeOfDay\": [\"morning\", \"noon\"],\n  \"isPublic\": true,\n  \"itinerary\": [{\n    \"day\": 1,\n    \"activities\": [\n      {\"time\":\"09:00\",\"name\":\"เที่ยวชายหาด\",\"location\":\"หาดพัทยา\",\"description\":\"เดินเล่นและถ่ายรูป\"},\n      {\"time\":\"12:00\",\"name\":\"รับประทานอาหาร\",\"location\":\"ร้านอาหารริมทะเล\",\"description\":\"อาหารกลางวัน\"},\n      {\"time\":\"14:00\",\"name\":\"คาเฟ่\",\"location\":\"คาเฟ่พัทยา\",\"description\":\"พักผ่อน\"}\n    ]\n  }]\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "id": "fced81d5-01ed-46a0-a625-89459b618e2f",
                "type": "text/javascript",
                "exec": [
                  "pm.test('IT-04 Create Trip: 201 Created', () => pm.response.to.have.status(201));",
                  "var createTripResponse = pm.response.json();",
                  "pm.expect(createTripResponse.trip.id).to.be.a('string');",
                  "pm.collectionVariables.set('tripId', createTripResponse.trip.id);"
                ],
                "_lastExecutionId": "89d6eba9-bf6e-4160-aa82-97ba31ddcca3"
              }
            }
          ]
