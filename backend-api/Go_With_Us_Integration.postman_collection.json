          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "id": "643aa9b7-f673-461c-b09e-ff79775e1220",
                "type": "text/javascript",
                "exec": [
                  "pm.test('IT-05 Matching: 200 OK', () => pm.response.to.have.status(200));",
                  "const payload = pm.response.json();",
                  "const trips = Array.isArray(payload) ? payload : (payload.trips || payload.matches || []);",
                  "const target = trips.find(t => t.id === pm.collectionVariables.get('tripId'));",
                  "pm.expect(target, 'created trip is returned').to.exist;",
                  "pm.expect(target.matchScore).to.be.a('number');"
                ],
                "_lastExecutionId": "fcf3255b-3072-43fa-8d3d-71928db9c491"
              }
            }
          ]
        }
      ]
